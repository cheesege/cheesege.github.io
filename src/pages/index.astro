---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Timeline from '../components/Timeline.astro';
import Contacts from '../components/Contacts.astro';
import Friends from '../components/Friends.astro';
import Certifications from '../components/Certifications.astro';
import Experience from '../components/Experience.astro';
import Teaching from '../components/Teaching.astro';
import Footer from '../components/Footer.astro';
import { contests, performances } from '../data/profile';
---

<BaseLayout
  title="起司哥的個人網頁"
  description="cheese_ge — 起司 / 起司哥 / cheese / cheesege。資訊，音樂。逢甲大學資訊工程學系、逢甲大學黑客社 13th 社長。"
>
  <Nav />

  <main id="main">
    <Hero />

    <Section id="about" title="關於" icon="user" kicker="你覺得我是什麼樣的人">
      <div class="about reveal">
        <p>
          早安，我是起司哥，也可以叫我起司，讓我知道你在叫我就好。
        </p>
        <p>
          目前是逢甲資工大三，黑客社社長，以前待過流行音樂社，喜歡去 KTV。
        </p>
      </div>
    </Section>

    <Section id="experience" title="經歷" icon="check" kicker="希望能多做一點事情">
      <Experience />
    </Section>

    <Section id="teaching" title="教課經驗" icon="board" kicker="教過的課程主題">
      <Teaching />
    </Section>

    <Section id="contest" title="比賽" icon="flag" kicker="那些打過的比賽跟蹭過的比賽">
      <Timeline items={contests} />
    </Section>

    <Section id="cert" title="檢定" icon="badge" kicker="考過的檢定">
      <Certifications />
    </Section>

    <Section id="performance" title="表演" icon="mic" kicker="以前表演過">
      <Timeline items={performances} />
    </Section>

    <Section id="contact" title="聯絡方式" icon="mail" kicker="你可以從這些地方找到我，如果需要的話">
      <Contacts />
    </Section>

    <Section id="friends" title="友站" icon="link" kicker="朋友或一些可以去看看的地方">
      <Friends />
    </Section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 1rem;
    max-width: 68ch;
    color: var(--text-muted);
    font-size: 1.02rem;
    line-height: 1.85;
  }
  .about strong { color: var(--text); font-weight: 700; }
</style>
