---
/** 一組 24x24 的 inline SVG，用 currentColor 上色。 */
export interface Props {
  name:
    | 'check'
    | 'flag'
    | 'mic'
    | 'cap'
    | 'user'
    | 'mail'
    | 'github'
    | 'discord'
    | 'instagram'
    | 'link'
    | 'copy'
    | 'sun'
    | 'moon'
    | 'arrow';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  width="24"
  height="24"
>
  {name === 'check' && (
    <>
      <path d="M4 12.9L7.14286 16.5L15 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M20 7.5625L11.4283 16.5625L11 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    </>
  )}
  {name === 'flag' && (
    <path d="M5 21V3.90002C5 3.90002 5.875 3 8.5 3C11.125 3 12.875 4.8 15.5 4.8C18.125 4.8 19 3.9 19 3.9V14.7C19 14.7 18.125 15.6 15.5 15.6C12.875 15.6 11.125 13.8 8.5 13.8C5.875 13.8 5 14.7 5 14.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  )}
  {name === 'mic' && (
    <>
      <rect x="9" y="2" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.8"/>
      <path d="M5 11C5 14.866 8.13401 18 12 18C15.866 18 19 14.866 19 11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="12" y1="18" x2="12" y2="21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="8" y1="21" x2="16" y2="21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </>
  )}
  {name === 'cap' && (
    <>
      <path d="M2 8.5L12 4L22 8.5L12 13L2 8.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M6 10.5V15.5C6 15.5 8 18 12 18C16 18 18 15.5 18 15.5V10.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M21.5 8.8V14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </>
  )}
  {name === 'user' && (
    <>
      <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/>
      <path d="M4.5 20.5c0-3.6 3.36-6 7.5-6s7.5 2.4 7.5 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </>
  )}
  {name === 'mail' && (
    <>
      <rect x="2.5" y="4.5" width="19" height="15" rx="3" stroke="currentColor" stroke-width="1.8"/>
      <path d="M3.5 7L11.03 12.02a1.75 1.75 0 0 0 1.94 0L20.5 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </>
  )}
  {name === 'github' && (
    <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.35 6.84 9.7.5.1.68-.22.68-.49l-.01-1.9c-2.78.62-3.37-1.22-3.37-1.22-.46-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.8-4.58 5.05.36.32.68.94.68 1.9l-.01 2.82c0 .27.18.6.69.49A10.06 10.06 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  )}
  {name === 'discord' && (
    <>
      <path d="M8.7 5.6A15 15 0 0 1 12 5.3c1.16 0 2.25.1 3.3.3.4-.75.68-1.3.68-1.3s2.6.5 4.1 1.7c0 0 2 3.6 2 8.4 0 0-1.3 2.2-4.6 2.9l-.9-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M15.3 18.7c0 .7.7 2 .7 2-2.2 0-4-1-4-1s-1.8 1-4 1c0 0 .7-1.3.7-2M8.7 5.6C8.3 4.85 8.02 4.3 8.02 4.3s-2.6.5-4.1 1.7c0 0-2 3.6-2 8.4 0 0 1.3 2.2 4.6 2.9l.9-1.6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      <ellipse cx="9" cy="12.3" rx="1.4" ry="1.7" fill="currentColor"/>
      <ellipse cx="15" cy="12.3" rx="1.4" ry="1.7" fill="currentColor"/>
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5.5" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/>
    </>
  )}
  {name === 'link' && (
    <>
      <path d="M10.5 13.5a3.8 3.8 0 0 0 5.66.35l2.6-2.6a3.8 3.8 0 0 0-5.37-5.37l-1.4 1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M13.5 10.5a3.8 3.8 0 0 0-5.66-.35l-2.6 2.6a3.8 3.8 0 0 0 5.37 5.37l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </>
  )}
  {name === 'copy' && (
    <>
      <rect x="9" y="9" width="11" height="11" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
      <path d="M15 5.5A2.5 2.5 0 0 0 12.5 4H6.5A2.5 2.5 0 0 0 4 6.5v6A2.5 2.5 0 0 0 5.5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </>
  )}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.8"/>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </>
  )}
  {name === 'moon' && (
    <path d="M20.5 14.3A8.6 8.6 0 0 1 9.7 3.5a8.6 8.6 0 1 0 10.8 10.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
  )}
  {name === 'arrow' && (
    <path d="M6 18L18 6M18 6H9M18 6v9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
  )}
</svg>
