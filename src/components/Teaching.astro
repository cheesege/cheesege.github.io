---
import { teaching } from '../data/profile';
---

<ul class="list">
  {teaching.map((t, i) => (
    <li class="item reveal" style={`--delay:${Math.min(i, 8) * 45}ms`}>
      <span class="head">
        <span class="topic">{t.topic}</span>
        {t.course && <span class="course">{t.course}</span>}
      </span>
      <span class="context">{t.context}</span>
    </li>
  ))}
</ul>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .item {
    display: grid;
    gap: 0.3rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .item:hover {
    border-color: var(--line-strong);
    background: var(--surface-hover);
    transform: translateX(3px);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .topic {
    color: var(--text);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .course {
    flex-shrink: 0;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: color-mix(in srgb, var(--amber) 12%, transparent);
    color: var(--amber);
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .context {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-faint);
  }

  @media (max-width: 560px) {
    .topic { font-size: 0.94rem; }
    .item { padding: 0.8rem 0.95rem; }
  }
</style>
