---
import Icon from './Icon.astro';
import { profile, education } from '../data/profile';
---

<section class="hero" id="top">
  <div class="wrap grid">
    <div class="text">
      <p class="eyebrow reveal">
        <span class="pill">HELLO</span>
        {profile.aliases}
      </p>

      <h1 class="reveal" style="--delay:60ms">
        <span class="handle">{profile.handle}</span>
      </h1>

      <p class="quip reveal" style="--delay:120ms">{profile.quip}</p>

      <p class="tagline reveal" style="--delay:180ms">
        {profile.tags.map((t, i) => (
          <>
            {i > 0 && <span class="sep" aria-hidden="true">，</span>}
            <span class="tag">{t}</span>
          </>
        ))}
      </p>

      <ul class="edu reveal" style="--delay:240ms">
        {education.map((e) => (
          <li>
            <Icon name="cap" class="cap" />
            <span><strong>{e.school}</strong>{e.note && <em>{e.note}</em>}</span>
          </li>
        ))}
      </ul>

      <div class="cta reveal" style="--delay:300ms">
        <a class="btn primary" href="#contact">
          聯絡我 <Icon name="arrow" class="ico" />
        </a>
        <a class="btn ghost" href="#experience">看看經歷</a>
      </div>
    </div>

    <div class="avatar reveal" style="--delay:160ms">
      <div class="ring" aria-hidden="true"></div>
      <img
        src="/img/cheese-cutout.png"
        alt="起司哥的個人形象圖"
        width="360"
        height="360"
        loading="eager"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(3rem, 9vw, 6.5rem) 0 clamp(2rem, 5vw, 3.5rem); }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    color: var(--text-muted);
    font-size: 0.92rem;
    font-family: var(--font-mono);
  }

  .pill {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--amber);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    font-weight: 600;
  }

  h1 { margin: 0.7rem 0 0; }

  .handle {
    display: inline-block;
    font-size: clamp(2.9rem, 9vw, 5rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    background: linear-gradient(100deg, var(--amber-deep), var(--amber) 42%, var(--amber-soft));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .quip { color: var(--text-faint); font-size: 0.95rem; margin-top: 0.25rem; }

  .tagline { margin-top: 1.1rem; font-size: clamp(1.15rem, 2.6vw, 1.5rem); font-weight: 700; }
  .tag { color: var(--text); }
  .sep { color: var(--amber); }

  .edu {
    list-style: none;
    margin: 1.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .edu li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted);
    font-size: 0.98rem;
  }
  .edu strong { color: var(--text); font-weight: 700; }
  .edu em { font-style: normal; color: var(--text-muted); margin-left: 0.45rem; }
  .edu :global(.cap) { width: 18px; height: 18px; color: var(--amber); flex-shrink: 0; }

  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1.25rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
    border: 1px solid transparent;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .btn :global(.ico) { width: 16px; height: 16px; }

  .primary {
    background: var(--amber);
    color: #170f00;
    box-shadow: 0 10px 30px -14px color-mix(in srgb, var(--amber) 90%, transparent);
  }
  :global(html[data-theme='light']) .primary { color: #fff; }
  .primary:hover { transform: translateY(-2px); box-shadow: 0 16px 34px -14px color-mix(in srgb, var(--amber) 95%, transparent); }

  .ghost { border-color: var(--line-strong); color: var(--text); background: var(--surface); }
  .ghost:hover { background: var(--surface-hover); transform: translateY(-2px); }

  .avatar { position: relative; display: grid; place-items: center; }
  .avatar img {
    position: relative;
    width: min(100%, 320px);
    height: auto;
    filter: drop-shadow(0 24px 44px rgba(0, 0, 0, 0.45));
    animation: float 7s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(-6px); }
    50% { transform: translateY(10px); }
  }

  .ring {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--amber) 26%, transparent), transparent 68%);
    filter: blur(18px);
  }

  @media (max-width: 780px) {
    .grid { grid-template-columns: 1fr; }
    .avatar { order: -1; }
    .avatar img { width: min(62%, 220px); }
  }
</style>
