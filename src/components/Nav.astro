---
import Icon from './Icon.astro';
import { nav, profile } from '../data/profile';
---

<header class="bar">
  <div class="inner">
    <a class="brand" href="#top">
      <span class="dot" aria-hidden="true"></span>
      <span class="brand-text">{profile.handle}</span>
    </a>

    <nav class="links" aria-label="主要導覽">
      {nav.map((n) => (
        <a href={`#${n.id}`} data-nav-link>{n.label}</a>
      ))}
    </nav>

    <button
      class="theme"
      type="button"
      data-theme-toggle
      aria-label="切換淺色 / 深色主題"
      aria-pressed="false"
    >
      <Icon name="sun" class="i sun" />
      <Icon name="moon" class="i moon" />
    </button>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    width: min(100% - 2.5rem, var(--maxw));
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--amber);
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--amber);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--amber) 60%, transparent);
    animation: pulse 2.6s ease-out infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--amber) 55%, transparent); }
    70% { box-shadow: 0 0 0 9px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .links::-webkit-scrollbar { display: none; }

  .links a {
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    white-space: nowrap;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .links a:hover { color: var(--text); background: var(--surface); }

  .links a.is-active {
    color: var(--amber);
    background: var(--surface-hover);
  }

  .theme {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--amber);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .theme:hover { background: var(--surface-hover); border-color: var(--line-strong); transform: translateY(-1px); }

  .theme :global(.i) { grid-area: 1 / 1; width: 17px; height: 17px; transition: opacity 0.2s ease, transform 0.3s ease; }
  .theme :global(.sun) { opacity: 0; transform: rotate(-40deg) scale(0.7); }
  .theme :global(.moon) { opacity: 1; }
  :global(html[data-theme='light']) .theme :global(.sun) { opacity: 1; transform: none; }
  :global(html[data-theme='light']) .theme :global(.moon) { opacity: 0; transform: rotate(40deg) scale(0.7); }

  @media (max-width: 720px) {
    .brand-text { display: none; }
    .links a { padding: 0.4rem 0.55rem; font-size: 0.82rem; }
  }
</style>
