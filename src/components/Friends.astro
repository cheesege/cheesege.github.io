---
import Icon from './Icon.astro';
import { friendSites } from '../data/profile';
---

<div class="grid">
  {friendSites.map((s, i) => {
    const linked = s.href !== '#';
    const Tag = linked ? 'a' : 'div';
    return (
      <Tag
        class:list={['card', 'reveal', { idle: !linked }]}
        style={`--delay:${i * 60}ms`}
        {...(linked ? { href: s.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <span class="favicon" aria-hidden="true">{s.name.slice(0, 1)}</span>

        <span class="meta">
          <span class="name">{s.name}</span>
          {linked && <span class="url">{s.href.replace(/^https?:\/\//, '').replace(/\/$/, '')}</span>}
        </span>

        <Icon name={linked ? 'arrow' : 'link'} class="go" />
      </Tag>
    );
  })}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }

  .card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: -1px -1px auto -1px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--amber), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  a.card:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    background: var(--surface-hover);
    box-shadow: var(--glow);
  }
  a.card:hover::before { opacity: 1; }

  .card.idle { opacity: 0.75; }

  .favicon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--amber) 16%, transparent);
    border: 1px solid var(--line);
    color: var(--amber);
    font-weight: 900;
    font-size: 1rem;
  }

  .meta { display: grid; min-width: 0; flex: 1; }
  .name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .url {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .card :global(.go) {
    width: 16px;
    height: 16px;
    color: var(--text-faint);
    flex-shrink: 0;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  a.card:hover :global(.go) { color: var(--amber); transform: translate(2px, -2px); }
</style>
