---
import Icon from './Icon.astro';
import { friendSites } from '../data/profile';
---

<div class="grid">
  {friendSites.map((s, i) => {
    const disabled = s.href === '#';
    const Tag = disabled ? 'div' : 'a';
    return (
      <Tag
        class:list={['card', 'reveal', { disabled }]}
        style={`--delay:${i * 60}ms`}
        {...(disabled ? {} : { href: s.href, target: '_blank', rel: 'noopener noreferrer' })}
      >
        <span class="top">
          <span class="favicon" aria-hidden="true">{s.name.slice(0, 1)}</span>
          <span class="names">
            <span class="name">{s.name}</span>
            <span class="owner">{s.owner}</span>
          </span>
          <Icon name={disabled ? 'link' : 'arrow'} class="go" />
        </span>

        <p class="desc">{s.description}</p>

        <span class="url">{disabled ? '尚未設定連結' : s.href.replace(/^https?:\/\//, '')}</span>

        {s.placeholder && <span class="tagline">佔位</span>}
      </Tag>
    );
  })}
</div>

<p class="hint reveal">友站清單請在 <code>src/data/profile.ts</code> 的 <code>friendSites</code> 修改。</p>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.15rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: -1px -1px auto -1px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--amber), transparent);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  a.card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
    background: var(--surface-hover);
    box-shadow: var(--glow);
  }
  a.card:hover::before { opacity: 1; }

  .card.disabled { opacity: 0.7; border-style: dashed; }

  .top { display: flex; align-items: center; gap: 0.65rem; }

  .favicon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    flex-shrink: 0;
    background: color-mix(in srgb, var(--amber) 16%, transparent);
    border: 1px solid var(--line);
    color: var(--amber);
    font-weight: 900;
    font-size: 0.95rem;
  }

  .names { display: grid; min-width: 0; flex: 1; }
  .name { font-weight: 700; font-size: 1rem; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .owner { font-family: var(--font-mono); font-size: 0.76rem; color: var(--text-faint); }

  .card :global(.go) { width: 16px; height: 16px; color: var(--text-faint); flex-shrink: 0; transition: color 0.2s ease, transform 0.2s ease; }
  a.card:hover :global(.go) { color: var(--amber); transform: translate(2px, -2px); }

  .desc { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }

  .url {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tagline {
    align-self: flex-start;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px dashed var(--line-strong);
    color: var(--text-faint);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .hint { margin-top: 1rem; font-size: 0.82rem; color: var(--text-faint); }
  .hint code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--amber);
  }
</style>
