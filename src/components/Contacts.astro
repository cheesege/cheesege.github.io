---
import Icon from './Icon.astro';
import { contacts } from '../data/profile';
---

<div class="grid">
  {contacts.map((c, i) => {
    const disabled = c.href === '#';
    const Tag = disabled ? 'div' : 'a';
    return (
      <Tag
        class:list={['card', 'reveal', { disabled }]}
        style={`--delay:${i * 60}ms`}
        {...(disabled ? {} : { href: c.href, target: c.href.startsWith('http') ? '_blank' : undefined, rel: c.href.startsWith('http') ? 'noopener noreferrer' : undefined })}
      >
        <span class="icon"><Icon name={c.icon} class="ico" /></span>

        <span class="meta">
          <span class="label">{c.label}</span>
          <span class="value">{c.value}</span>
        </span>

        {c.copy ? (
          <button
            class="act"
            type="button"
            data-copy={c.value}
            aria-label={`複製 ${c.label}`}
          >
            <Icon name="copy" class="ico" />
            <Icon name="check" class="ico check" />
          </button>
        ) : (
          <span class="act arrow" aria-hidden="true"><Icon name="arrow" class="ico" /></span>
        )}
      </Tag>
    );
  })}
</div>

<p class="hint reveal">未填的連結請在 <code>src/data/profile.ts</code> 的 <code>contacts</code> 補上。</p>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }

  .card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.22s ease, background 0.22s ease, box-shadow 0.22s ease;
  }

  a.card:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
    background: var(--surface-hover);
    box-shadow: var(--glow);
  }

  .card.disabled { opacity: 0.72; }

  .icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--amber) 14%, transparent);
    border: 1px solid var(--line);
    color: var(--amber);
    flex-shrink: 0;
  }
  .icon :global(.ico) { width: 20px; height: 20px; }

  .meta { display: grid; min-width: 0; flex: 1; }
  .label { font-size: 0.74rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint); font-weight: 600; }
  .value {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .act {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    padding: 0;
    flex-shrink: 0;
    border-radius: 9px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
    transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .act :global(.ico) { grid-area: 1 / 1; width: 16px; height: 16px; transition: opacity 0.18s ease, transform 0.18s ease; }
  .act :global(.check) { opacity: 0; transform: scale(0.6); color: var(--amber); }

  button.act:hover { color: var(--amber); background: var(--surface-hover); border-color: var(--line); }
  button.act.copied :global(.ico) { opacity: 0; }
  button.act.copied :global(.check) { opacity: 1; transform: none; }

  .arrow { color: var(--text-faint); }
  a.card:hover .arrow { color: var(--amber); transform: translate(2px, -2px); }

  .hint { margin-top: 1rem; font-size: 0.82rem; color: var(--text-faint); }
  .hint code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.1rem 0.35rem;
    border-radius: 5px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--amber);
  }
</style>
